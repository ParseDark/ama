{
  "name": "ama",
  "version": "0.4.0",
  "description": "Local-first Chrome side-panel assistant with page tools, memory, MCP, and optional semantic retrieval.",
  "private": true,
  "license": "MIT",
  "author": "ParseDark",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ParseDark/ama.git"
  },
  "homepage": "https://github.com/ParseDark/ama#readme",
  "bugs": {
    "url": "https://github.com/ParseDark/ama/issues"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt zip",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "models:generate": "node tools/generate-model-catalog.mjs",
    "format": "prettier --write src tests *.ts *.json",
    "format:check": "prettier --check src tests *.ts *.json"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "latest",
    "@ai-sdk/google": "latest",
    "@ai-sdk/mcp": "latest",
    "@ai-sdk/openai": "latest",
    "@ai-sdk/openai-compatible": "latest",
    "@ai-sdk/react": "latest",
    "@base-ui/react": "latest",
    "@mozilla/readability": "latest",
    "@opencode-ai/models": "0.0.110",
    "@shikijs/langs": "3.23.0",
    "@shikijs/themes": "3.23.0",
    "@streamdown/cjk": "latest",
    "ai": "^7.0.142",
    "class-variance-authority": "0.7.1",
    "clsx": "latest",
    "cn": "latest",
    "diff": "9.0.0",
    "es-module-lexer": "2.3.2",
    "idb": "8.0.4",
    "ignore": "7.0.12",
    "lucide-react": "latest",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shiki": "3.23.0",
    "streamdown": "latest",
    "tailwind-merge": "latest",
    "tailwindcss": "^4.1.0",
    "turndown": "latest",
    "turndown-plugin-gfm": "latest",
    "tw-animate-css": "latest",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@tailwindcss/vite": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/turndown": "latest",
    "@wxt-dev/module-react": "latest",
    "fake-indexeddb": "6.2.4",
    "happy-dom": "latest",
    "prettier": "^3.9.10",
    "typescript": "latest",
    "vitest": "latest",
    "wxt": "^0.21.4"
  },
  "packageManager": "pnpm@9.15.9"
}
